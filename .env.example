# Copy this file to .env and fill it in. .env is never committed.

# The first password of the "admin" account, used once, on the first start. After that, change it in the app
# (Settings). Forgot it? Put a new one here, add ANVIL_RESET_PASSWORD=1, restart, then remove that line again.
ANVIL_PASSWORD=

# Host folders, mounted into the container at fixed paths. Create them first (mkdir -p), so they belong to you.
# anvil's own data: accounts, runs, uploaded datasets.            -> /data
ANVIL_DATA=/srv/anvil/data
# The Hugging Face cache: downloaded models and datasets.          -> /hf-cache
ANVIL_HF_CACHE=/srv/anvil/hf-cache
# Local models you want to pick from.                              -> /models
ANVIL_MODELS=/srv/anvil/models
# Dataset files you want to pick from (uploads go into ANVIL_DATA). -> /datasets
ANVIL_DATASETS=/srv/anvil/datasets

# Optional: a Hugging Face token for everyone on this anvil. Usually you add yours in the app instead (Settings).
HF_TOKEN=

# Your GPU's architecture, for the kernels compiled into the image (rocminfo or rocm-smi shows it, e.g. gfx1201 for an
# R9700, gfx1100 for an RX 7900). Rebuild after changing it: docker compose build.
ANVIL_GPU_ARCH=gfx1201

# Your user and group ids (`id -u`, `id -g`), so files written by the container belong to you.
ANVIL_UID=1000
ANVIL_GID=1000

# Optional: 1 switches off the fast kernels for linear-attention models (flash-linear-attention and causal-conv1d), if a
# model misbehaves with them.
# ANVIL_SAFE_KERNELS=1
